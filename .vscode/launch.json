        {
            //========================================================
            // Python tools debug launch
            //========================================================
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}/tools",
        },
        {
            //========================================================
