{
    "pylint.args": [
        "--max-statements=74",
        "--max-branches=25",
        "--max-public-methods=60",
        "--max-locals=23",
        "--max-attributes=15",
        "--max-positional-arguments=12",
        "--max-args=12",
        "--max-line-length=120"
    ],
    "python.analysis.typeCheckingMode": "basic",
    "editor.suggest.showStatusBar": false,
    "cmake.showSystemKits": true,

}